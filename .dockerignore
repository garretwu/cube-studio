*
!.dockerignore
!lib/**
!fault_injector/**
!sre_agent/**

# Keep the runtime image focused on the SRE agent service only.
sre_agent/__pycache__/
sre_agent/**/*.pyc
sre_agent/docs/
sre_agent/tests/
sre_agent/temp/
sre_agent/scripts/sre_agent/
sre_agent/frontend/node_modules/
sre_agent/frontend/node_modules.broken*/
sre_agent/frontend/src/**/*.test.ts
sre_agent/frontend/src/**/*.test.tsx
sre_agent/frontend/src/**/__tests__/

fault_injector/__pycache__/
fault_injector/**/*.pyc
fault_injector/tests/
fault_injector/docs/
fault_injector/agent_docs/

lib/__pycache__/
lib/**/*.pyc
lib/tests/
